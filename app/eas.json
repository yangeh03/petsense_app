{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "internal": {
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://81.71.71.31"
      }
    },
    "production": {
      "channel": "production",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://81.71.71.31"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
