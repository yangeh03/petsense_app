{
  "expo": {
    "name": "PetSense",
    "slug": "petsense_app",
    "version": "1.0.0",
    "owner": "yangenhui",
    "runtimeVersion": "exposdk:57.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petsenseapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.yangeh03.petsense",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E5F6EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1FA35C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "允许 PetSense 录制宠物动作与时间校准视频。",
          "microphonePermission": "允许 PetSense 同步记录校准视频的声音。",
          "recordAudioAndroid": true
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b390999e-ff9a-44f8-9028-05691e764f80"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/b390999e-ff9a-44f8-9028-05691e764f80"
    }
  }
}
